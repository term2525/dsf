Create a Node.js file that opens the requested file and returns the content to the client. If                                                                 
   anything goes wrong, throw a 404 error.                                                                                                                       
                                                                                                                                                                 
   const http = require('http');                                                                                                                                 
   const fs = require('fs');                                                                                                                                     
   const { parse } = require('querystring');                                                                                                                     
                                                                                                                                                                 
   const server = http.createServer((req, res) => {                                                                                                              
     if (req.method === 'GET') {                                                                                                                                 
       // Show the form                                                                                                                                          
       res.writeHead(200, { 'Content-Type': 'text/html' });                                                                                                      
       res.end(`                                                                                                                                                 
         <h2>File Reader</h2>                                                                                                                                    
         <form method="POST">                                                                                                                                    
           <input type="text" name="filename" placeholder="e.g., a.txt" required><br><br>                                                                        
           <button type="submit">Read File</button>                                                                                                              
         </form>                                                                                                                                                 
       `);                                                                                                                                                       
     }                                                                                                                                                           
     else if (req.method === 'POST') {                                                                                                                           
       let body = '';                                                                                                                                            
       req.on('data', chunk => { body += chunk.toString(); });                                                                                                   
       req.on('end', () => {                                                                                                                                     
         const { filename } = parse(body);                                                                                                                       
                                                                                                                                                                 
         // Basic safety: block paths with slashes to keep reading only in current folder                                                                        
         if (filename.includes('/') || filename.includes('\\')) {                                                                                                
           res.writeHead(400, { 'Content-Type': 'text/html' });                                                                                                  
           return res.end('<h3>Bad Request: please enter a simple filename, not a path.</h3><a href="/">Back</a>');                                              
         }                                                                                                                                                       
                                                                                                                                                                 
         fs.readFile('./' + filename, 'utf8', (err, data) => {                                                                                                   
           if (err) {                                                                                                                                            
             res.writeHead(404, { 'Content-Type': 'text/html' });                                                                                                
             return res.end(`<h3>404 – File "${filename}" not found!</h3><a href="/">Try again</a>`);                                                            
           }                                                                                                                                                     
           res.writeHead(200, { 'Content-Type': 'text/plain' });                                                                                                 
           res.write(data);          // the file contents                                                                                                        
           res.end();                                                                                                                                            
         });                                                                                                                                                     
       });                                                                                                                                                       
     }                                                                                                                                                           
   });                                                                                                                                                           
                                                                                                                                                                 
   server.listen(3000, () => console.log('Server running at http://localhost:3000'));                                                                            
                                                                                                                                                                 
